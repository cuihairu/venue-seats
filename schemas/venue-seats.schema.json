{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cuihairu.github.io/venue-seats/schemas/venue-seats.schema.json",
  "title": "venue-seats venue document",
  "type": "object",
  "required": ["schemaVersion", "venue", "priceTiers", "levels"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "venue": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      }
    },
    "stage": {
      "type": "object",
      "required": ["x", "y", "rotation"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "rotation": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" }
      }
    },
    "provenance": { "enum": ["official", "demo"] },
    "priceTiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "color"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "color": { "type": "string" },
          "price": { "type": "number" }
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sections"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "polygon", "rows"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "priceTierId": { "type": "string" },
                "polygon": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "items": { "type": "number" }
                  }
                },
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "seats"],
                    "properties": {
                      "id": { "type": "string" },
                      "label": { "type": "string" },
                      "seats": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["id", "x", "y", "status"],
                          "properties": {
                            "id": { "type": "string" },
                            "label": { "type": "string" },
                            "x": { "type": "number" },
                            "y": { "type": "number" },
                            "status": { "enum": ["available", "selected", "sold", "held"] },
                            "priceTierId": { "type": "string" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
